{
  "name": "kira-chat",
  "version": "4.3.0",
  "private": true,
  "description": "Offline dialogue and a deterministic multi-character narrative SDK with attributed memory, knowledge, and replay.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "python3 tools/build.py",
    "check": "python3 tools/build.py --check && node tools/build-themes.cjs --check && node tools/extend-artifact.cjs --check",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm test",
    "demo": "python3 -m http.server 8042 --bind 127.0.0.1",
    "example": "node examples/station.cjs",
    "compile:narrative": "node tools/narrative.cjs",
    "apk": "cd android && gradle --no-daemon assembleRelease",
    "themes": "node tools/build-themes.cjs",
    "vocab": "node tools/extend-artifact.cjs && python3 tools/build.py --pin"
  },
  "files": [
    "Kira.html",
    "src",
    "tools",
    "LICENSE",
    "README.md",
    "KiraSDK.js",
    "examples",
    "docs",
    "android",
    "themes"
  ],
  "main": "KiraSDK.js"
}
